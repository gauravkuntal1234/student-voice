# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to administer the portal.
ADMIN_EMAILS=

# Comma-separated faculty Google accounts. These must be approved by the portal owner.
FACULTY_EMAILS=

# SMTP account used to send student verification codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_PEPPER=

# Local development defaults
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=student_voice
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CREATE_DATABASE=true
MIGRATE_SQLITE=false
SESSION_DAYS=7
